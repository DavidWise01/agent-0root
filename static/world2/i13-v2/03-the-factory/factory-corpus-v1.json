  "fixed": {
   "pairs": {
    "(": ")"
   },
   "words": {
    "IF": "END IF"
   },
   "plane": 1,
   "rules": [
    "veto",
    "-I",
    "idempotence",
    "address"
   ],
   "members": 18,
   "exemplar": "fortran",
   "trap": "CARD COLUMNS 1-6 CARRY STATE. column 6 non-blank = continuation. collapsing leading whitespace destroys the statement head and drops the agent from 54% to 16%. DO terminates at a NUMBERED LABEL \u2014 a map lookup, not a stack pop. exclude it.",
   "quantile_default": 0.99,
   "quantile_note": "COBOL H=0.582 needs q=0.50; FORTRAN H=1.279 needs q=0.99. they share this family and NO single default is correct for both. this is the exemplar case for why quantile must be measured on the source, not inherited from the family. the default here is the CONSERVATIVE one (0.99) because over-provisioning is safe and under-provisioning fails."
  },
